#!/usr/bin/env bash

# Log output:
#
# * 51c333e    (12 days)    <Gary Bernhardt>   add vim-eunuch
#
# The time massaging regexes start with ^[^<]* because that ensures that they
# only operate before the first "<". That "<" will be the beginning of the
# author name, ensuring that we don't destroy anything in the commit message
# that looks like time.
#
# The log format uses } characters between each field, and `column` is later
# used to split on them. A } in the commit subject or any other field will
# break this.

HASH="%C(yellow)%h%Creset"
RELATIVE_TIME="%Cgreen(%ar)%Creset"
AUTHOR="%C(bold blue)<%an>%Creset"
REFS="%C(red)%d%Creset"
SUBJECT="%s"

FORMAT="$HASH}$RELATIVE_TIME}$AUTHOR}$REFS $SUBJECT"

show_git_head() {
    pretty_git_log -1
    git show -p --pretty="tformat:"
}

pretty_git_log() {
    git log --graph --color --pretty="tformat:${FORMAT}" $* |
        # Replace (2 years ago) with (2 years)
        sed -Ee 's/(^[^<]*) ago\)/\1)/' |
        # Replace (2 years, 5 months) with (2 years)
        sed -Ee 's/(^[^<]*), [[:digit:]]+ .*months?\)/\1)/' |
        # Line columns up based on } delimiter
        column -s '}' -t |
        # Page only if we need to
        less -FXRS
}

prune_and_delete_merged() {
    git checkout main
    git pull --rebase
    git remote prune origin
    
    # Get list of branches used by worktrees
    WORKTREE_BRANCHES=$(git worktree list --porcelain | grep '^branch' | cut -d' ' -f2 | cut -d'/' -f3-)
    
    # Process merged branches, skipping current branch and worktree branches
    git branch --merged | grep -v "^\*" | while IFS= read -r branch; do
        # Remove leading whitespace and * or + if present
        stale_branch=$(echo "$stale_branch" | sed 's/^[* ]*//')
        stale_branch=$(echo "$stale_branch" | sed 's/^[+ ]*//')
        
        # Skip if branch is used by a worktree
        if echo "$WORKTREE_BRANCHES" | grep -q "^$branch$"; then
            echo "Skipping branch '$branch' (used by worktree)"
        else
            git branch -d "$branch"
        fi
    done
}

clean_local() {
    BRANCH=$(git rev-parse --abbrev-ref HEAD)
    if [ "$BRANCH" != "main" ]; then
        read -p "Are you sure you want to run while not in main (you run the risk of deleting main)? (y/n) " choice
        if [ "$choice" != "Y" ] && [ "$choice" != "y" ]; then
            echo "Nothing done"
            exit 0
        fi
    fi
    
    # Get list of branches used by worktrees
    WORKTREE_BRANCHES=$(git worktree list --porcelain | grep '^branch' | cut -d' ' -f2 | cut -d'/' -f3-)
    
    # Process merged branches, skipping worktree branches
    git branch --merged "$BRANCH" | grep -v "^[* ]*$BRANCH$" | while IFS= read -r stale_branch; do
        # Remove leading whitespace and * or + if present
        stale_branch=$(echo "$stale_branch" | sed 's/^[* ]*//')
        stale_branch=$(echo "$stale_branch" | sed 's/^[+ ]*//')

        # Skip if branch is used by a worktree
        if echo "$WORKTREE_BRANCHES" | grep -q "^$stale_branch$"; then
            echo "Skipping branch '$stale_branch' (used by worktree)"
        else
            git branch -d "$stale_branch"
        fi
    done
}

